# Boardly configuration for local development.
# `make dev-backend` copies this file to .env if there is none and then loads
# .env. Variables already set in your shell take precedence over the file.

# Port the server listens on.
BOARDLY_PORT=8080

# SQLite database file, relative to the repository root. The sqlite-web dev
# service (compose.yaml) mounts ./data, so keep the file in there.
BOARDLY_DB_PATH=./data/boardly.db

# Directory for files the server writes itself, such as favicons and uploaded
# images (in its images folder).
BOARDLY_DATA_DIR=./data

# Log format: json or text.
BOARDLY_LOG_FORMAT=text

# Which HTTP requests get a log line: all, errors (status 500 and higher) or
# none. A successful health check is never logged.
# BOARDLY_LOG_REQUESTS=all

# Public URL of the web app. In development that is the Vite dev server,
# which proxies /api to this server.
BOARDLY_BASE_URL=http://localhost:3000

# Name the web app and sign-in emails show, e.g. to tell a staging system
# apart. The Vite dev server always shows Boardly; the built app shows this.
# BOARDLY_APP_TITLE=Boardly

# HTML inserted before </head> of the web app on every page, e.g. the script tag
# of an analytics tool. Only the built app served by this server includes it.
# BOARDLY_ANALYTICS_SNIPPET=<script defer src="https://stats.example.org/script.js" data-website-id="..."></script>

# Whether the first sign-in with a new email address creates an account. Set to
# false to close registration: existing users still sign in, new addresses get
# an email saying that registration is closed.
# BOARDLY_ALLOW_REGISTRATION=true

# Sign-in emails go to the Mailpit dev service (UI: http://localhost:8025).
# Remove BOARDLY_SMTP_HOST to write sign-in links to the server log instead.
BOARDLY_SMTP_HOST=localhost
BOARDLY_SMTP_PORT=1025
BOARDLY_SMTP_TLS=none

# SMTP login. Mailpit needs none; set both for servers that require
# authentication. Leave the username empty to send without logging in.
# BOARDLY_SMTP_USERNAME=boardly@example.org
# BOARDLY_SMTP_PASSWORD=change-me

# Sender address of sign-in emails.
# BOARDLY_SMTP_FROM=Boardly <noreply@localhost>

# Passkeys are bound to the host name of BOARDLY_BASE_URL (here: localhost).
# BOARDLY_WEBAUTHN_RP_ID=localhost

# Passkey provider names and icons are downloaded from this list and cached in
# data/aaguids.json. Set it to an empty value to turn provider detection off.
# BOARDLY_AAGUID_LIST_URL=https://raw.githubusercontent.com/passkeydeveloper/passkey-authenticator-aaguids/main/combined_aaguid.json

# Take the client IP from X-Forwarded-For (for rate limiting). Enable it only
# behind a reverse proxy that sets this header.
# BOARDLY_TRUST_PROXY_HEADERS=false

# Favicons and link previews aren't fetched from private, loopback or
# link-local addresses by default. Set to true when your links point to
# services on your own network.
# BOARDLY_FETCH_ALLOW_PRIVATE=false

# Preview images: the largest download in megabytes, the largest size in
# pixels (width times height) that is decoded, and the width larger images are
# scaled down to.
# BOARDLY_PREVIEW_MAX_SIZE_MB=10
# BOARDLY_PREVIEW_MAX_PIXELS=25000000
# BOARDLY_PREVIEW_WIDTH=800

# Note attachments: the largest file in megabytes, and how many days an
# attachment that no note uses stays marked for deletion before it is deleted.
# BOARDLY_ATTACHMENT_MAX_SIZE_MB=5
# BOARDLY_ATTACHMENT_DELETE_AFTER_DAYS=30

# Allowed attachment types: a comma-separated list of content types, or
# <group>/* for all types of a group (image/*, audio/*, video/*, text/*,
# application/*). Unset allows the images except SVG, and PDF:
# BOARDLY_ATTACHMENT_TYPES=image/png,image/jpeg,image/gif,image/webp,image/avif,image/bmp,image/vnd.microsoft.icon,application/pdf
#
# All known types (attachments are public to anyone with their link):
#   image/png                 .png
#   image/jpeg                .jpg .jpeg
#   image/gif                 .gif
#   image/webp                .webp
#   image/avif                .avif
#   image/bmp                 .bmp
#   image/vnd.microsoft.icon  .ico
#   image/svg+xml             .svg   (risky: can contain scripts; always downloaded)
#   application/pdf           .pdf
#   audio/mpeg                .mp3
#   audio/ogg                 .ogg .oga
#   audio/wav                 .wav
#   video/mp4                 .mp4
#   video/webm                .webm
#   text/plain                .txt
#   text/markdown             .md
#   text/csv                  .csv
#   application/json          .json
#   text/html                 .html .htm   (risky: can contain scripts; always downloaded)
#   application/vnd.openxmlformats-officedocument.wordprocessingml.document    .docx
#   application/vnd.openxmlformats-officedocument.spreadsheetml.sheet          .xlsx
#   application/vnd.openxmlformats-officedocument.presentationml.presentation  .pptx
#   application/vnd.oasis.opendocument.text          .odt
#   application/vnd.oasis.opendocument.spreadsheet   .ods
#   application/vnd.oasis.opendocument.presentation  .odp
#   application/zip              .zip
#   application/x-7z-compressed  .7z
#   application/x-tar            .tar
#   application/gzip             .gz .tgz

# MapLibre style that maps of note locations are drawn from. Opening a map
# loads its data from this provider, which sees the viewer's IP address and the
# area viewed. Unset uses OpenFreeMap:
# BOARDLY_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Base URL of the boardly container that `docker compose up` starts
# (compose.yaml). Not BOARDLY_BASE_URL, which points to Vite here; the server
# itself doesn't read this variable.
# BOARDLY_COMPOSE_BASE_URL=http://localhost:8080
