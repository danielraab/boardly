# Famodash configuration for local development.
# `make dev-backend` copies this file to .env if there is none and then loads
# .env. Variables already set in your shell take precedence over the file.

# Port the server listens on.
FAMODASH_PORT=8080

# SQLite database file, relative to the repository root. The sqlite-web dev
# service (compose.yaml) mounts ./data, so keep the file in there.
FAMODASH_DB_PATH=./data/famodash.db

# Directory for files the server writes itself, such as favicons and uploaded
# images (in its images folder).
FAMODASH_DATA_DIR=./data

# Log format: json or text.
FAMODASH_LOG_FORMAT=text

# Public URL of the web app. In development that is the Vite dev server,
# which proxies /api to this server.
FAMODASH_BASE_URL=http://localhost:3000

# Sign-in emails go to the Mailpit dev service (UI: http://localhost:8025).
# Remove FAMODASH_SMTP_HOST to write sign-in links to the server log instead.
FAMODASH_SMTP_HOST=localhost
FAMODASH_SMTP_PORT=1025
FAMODASH_SMTP_TLS=none

# SMTP login. Mailpit needs none; set both for servers that require
# authentication. Leave the username empty to send without logging in.
# FAMODASH_SMTP_USERNAME=famodash@example.org
# FAMODASH_SMTP_PASSWORD=change-me

# Sender address of sign-in emails.
# FAMODASH_SMTP_FROM=Famodash <noreply@localhost>

# Passkeys are bound to the host name of FAMODASH_BASE_URL (here: localhost).
# FAMODASH_WEBAUTHN_RP_ID=localhost

# Passkey provider names and icons are downloaded from this list and cached in
# data/aaguids.json. Set it to an empty value to turn provider detection off.
# FAMODASH_AAGUID_LIST_URL=https://raw.githubusercontent.com/passkeydeveloper/passkey-authenticator-aaguids/main/combined_aaguid.json

# Favicons aren't fetched from private, loopback or link-local addresses by
# default. Set to true when your links point to services on your own network.
# FAMODASH_FETCH_ALLOW_PRIVATE=false
